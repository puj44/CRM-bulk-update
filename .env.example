# ---------- app ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# pretty logs need pino-pretty (dev dependency), keep false in production
LOG_PRETTY=true

# ---------- database / redis ----------
# connection_limit should be at least PLANNER_CONCURRENCY + BATCH_CONCURRENCY + a few spare
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_bulk?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6379

# only used by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm_bulk
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- http / security ----------
# * or a comma separated list of origins
CORS_ORIGIN=*
# number of proxies in front of the api (0 when running it directly)
TRUST_PROXY=0
JSON_BODY_LIMIT=5mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CREATE_RATE_LIMIT_MAX=20

# ---------- file uploads (.csv / .xlsx) ----------
# api and workers must both be able to read this folder (shared volume / s3 in prod)
UPLOAD_DIR=uploads
# sized for about a million records per file, 100 is also the most env.ts allows
MAX_UPLOAD_SIZE_MB=100

# ---------- bulk processing ----------
MAX_JSON_RECORDS=10000
# must be a multiple of BATCH_SIZE
PLANNER_CHUNK_SIZE=5000
BATCH_SIZE=1000
PLANNER_CONCURRENCY=2
BATCH_CONCURRENCY=5
BATCH_TX_TIMEOUT_MS=30000
BATCH_TX_MAX_WAIT_MS=10000
# how often each worker checks postgres for unfinished actions whose jobs redis lost
RECOVERY_INTERVAL_MS=300000

# ---------- queue ----------
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=2000
KEEP_COMPLETED_JOBS=1000
KEEP_FAILED_JOBS=5000
SHUTDOWN_TIMEOUT_MS=30000
